{
  "name": "wstfchain",
  "version": "1.0.0",
  "description": "WSTFChain - Production blockchain with cross-chain bridge coordination and access control",
  "main": "dist/index.js",
  "bin": {
    "wstf": "./dist/runner/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "wstf": "ts-node src/runner/cli.ts",
    "wstf:help": "ts-node src/runner/cli.ts help",
    "wstf:version": "ts-node src/runner/cli.ts version",
    "wstf:profiles": "ts-node src/runner/cli.ts profiles",
    "start": "ts-node src/runner/cli.ts start",
    "start:dev": "ts-node src/runner/cli.ts start --profile=dev",
    "start:testnet": "ts-node src/runner/cli.ts start --profile=testnet",
    "start:mainnet": "ts-node src/runner/cli.ts start --profile=mainnet",
    "start:minimal": "ts-node src/runner/cli.ts start --profile=minimal",
    "start:full": "ts-node src/runner/cli.ts start --profile=full",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:crypto": "vitest run src/crypto/crypto.test.ts src/tx/tx.test.ts",
    "test:instructions": "vitest run src/instructions/instructions.test.ts src/programs/programs.test.ts src/runner/instruction/runner.test.ts",
    "test:rpc": "vitest run src/rpc/simple.test.ts src/rpc/programs.test.ts src/observability/health.test.ts",
    "test:integration": "vitest run src/integration/determinism.test.ts src/integration/edge-cases.test.ts src/integration/markets-authz.test.ts",
    "test:fastpath": "vitest run src/fastpath/hotwindow.test.ts src/fastpath/trust.test.ts src/events/logs/logs.test.ts",
    "test:determinism": "vitest run src/integration/determinism.test.ts",
    "test:vectors": "vitest run src/instructions/instructions.test.ts",
    "test:chaos": "vitest run src/auth/wstf.chaos.test.ts src/service/connector/connector.chaos.test.ts src/service/connector/moodGame.test.ts src/tokens/chaos.test.ts src/vars/chaos.test.ts src/markets/chaos.test.ts",
    "test:tokens": "vitest run src/tokens/tokens.test.ts src/tokens/handlers.test.ts src/tokens/chaos.test.ts",
    "test:markets": "vitest run src/markets/",
    "test:vars": "vitest run src/vars/vars.test.ts src/vars/chaos.test.ts",
    "test:auth": "vitest run src/auth/",
    "test:accounts": "vitest run src/accounts/",
    "test:sdk": "vitest run src/sdk/",
    "test:bench": "vitest run src/bench/",
    "test:smoke:crypto": "ts-node src/test/smoke.ts",
    "test:smoke:instructions": "ts-node src/test/m2-smoke.ts",
    "test:smoke:p2p": "ts-node src/test/m3-smoke.ts",
    "test:smoke:chain": "ts-node src/test/m4-smoke.ts",
    "test:smoke:fastpath": "ts-node src/test/fastpath-smoke.ts",
    "lint": "tsc --noEmit",
    "bench": "ts-node src/bench/bench.ts",
    "bench:slo": "ts-node src/bench/slo-bench.ts",
    "bench:basic-v1": "ts-node src/bench/bench.ts --scenario=basic-v1",
    "bench:v2-small": "ts-node src/bench/bench.ts --scenario=v2-small",
    "bench:mix": "ts-node src/bench/bench.ts --scenario=mix",
    "bench:eval": "ts-node --transpile-only -e \"require('./src/bench/eval').runEvalCLI()\"",
    "bench:quick": "ts-node --transpile-only -e \"require('./src/bench/eval').quickEval().then((r: any) => console.log(r))\"",
    "sdk:build": "cd src/sdk && node build.mjs",
    "sdk:test": "vitest run src/sdk/sdk.test.ts",
    "sdk:test:all": "vitest run src/sdk/",
    "sdk:publish:dry": "cd src/sdk && npm publish --dry-run",
    "sdk:publish": "cd src/sdk && npm publish --access public",
    "cli:build": "cd src/cli && node build.mjs",
    "cli:publish:dry": "cd src/cli && npm publish --dry-run",
    "cli:publish": "cd src/cli && npm publish --access public"
  },
  "keywords": [
    "blockchain",
    "crypto",
    "ed25519",
    "secp256k1"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bs58check": "^4.0.0",
    "cbor": "^10.0.11",
    "express": "^5.1.0",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/ui": "^4.0.12",
    "esbuild": "^0.24.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.12"
  }
}
