{
  "name": "wstfchain",
  "version": "0.1.0",
  "description": "WSTFChain - A minimal blockchain implementation with multi-algorithm support",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node",
    "start": "node dist/runner/run.js",
    "start:m3": "ts-node src/runner/run-m3.ts",
    "start:unified": "ts-node src/runner/unified.ts",
    "test": "ts-node src/test/smoke.ts",
    "test:m1": "ts-node src/test/smoke.ts",
    "test:m2": "ts-node src/test/m2-smoke.ts",
    "test:m3": "ts-node src/test/m3-smoke.ts",
    "test:m4": "ts-node src/test/m4-smoke.ts",
    "test:m5": "ts-node src/test/fastpath-smoke.ts",
    "test:fastpath": "ts-node src/test/fastpath-smoke.ts",
    "test:all": "npm run test:m1 && npm run test:m2 && npm run test:m3 && npm run test:m4 && npm run test:m5",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:full": "npm run test:all && npm run test:unit",
    "test:determinism": "vitest run src/integration/determinism.test.ts",
    "test:vectors": "vitest run src/instructions/instructions.test.ts",
    "test:chaos": "vitest run src/auth/wstf.chaos.test.ts src/service/connector/connector.chaos.test.ts src/service/connector/moodGame.test.ts src/tokens/chaos.test.ts src/vars/chaos.test.ts",
    "lint": "tsc --noEmit",
    "bench": "ts-node src/bench/bench.ts",
    "bench:slo": "ts-node src/bench/slo-bench.ts",
    "bench:basic-v1": "ts-node src/bench/bench.ts --scenario=basic-v1",
    "bench:v2-small": "ts-node src/bench/bench.ts --scenario=v2-small",
    "bench:mix": "ts-node src/bench/bench.ts --scenario=mix",
    "bench:eval": "ts-node --transpile-only -e \"require('./src/bench/eval').runEvalCLI()\"",
    "bench:quick": "ts-node --transpile-only -e \"require('./src/bench/eval').quickEval().then((r: any) => console.log(r))\""
  },
  "keywords": [
    "blockchain",
    "crypto",
    "ed25519",
    "secp256k1"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bs58check": "^4.0.0",
    "cbor": "^10.0.11",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/ui": "^4.0.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.12"
  }
}
