{
  "name": "@wstf/sdk",
  "version": "1.0.0",
  "description": "WSTFChain Node/Backend SDK - Production-ready SDK for bridge nodes, indexers, and backend services",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./network": {
      "import": "./dist/network/index.mjs",
      "require": "./dist/network/index.cjs",
      "types": "./dist/network/index.d.ts"
    },
    "./bridge": {
      "import": "./dist/bridge/index.mjs",
      "require": "./dist/bridge/index.cjs",
      "types": "./dist/bridge/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs",
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "wstfchain",
    "blockchain",
    "bridge",
    "cross-chain",
    "sdk",
    "defi"
  ],
  "author": "Wasserstoff India",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wasserstoff-india/wstfchain.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/wasserstoff-india/wstfchain#readme",
  "bugs": {
    "url": "https://github.com/wasserstoff-india/wstfchain/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bs58check": "^4.0.0",
    "cbor": "^10.0.11"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}